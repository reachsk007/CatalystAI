//@version=6
strategy("CatalystAI VWAPPlus PRO — Combined Decision Engine", "CatalystAI VWAPPlus PRO", overlay = true, initial_capital = 100000, pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 1, process_orders_on_close = false, calc_on_order_fills = true)

groupTest = "01 — Backtest controls"
startDate = input.time(timestamp("01 Jan 2015 00:00 +0000"), "Start date", group = groupTest)
endDate = input.time(timestamp("31 Dec 2099 00:00 +0000"), "End date", group = groupTest)
allowLongs = input.bool(true, "Allow long entries", group = groupTest)
allowShorts = input.bool(true, "Allow short entries", group = groupTest)
tradeSession = input.session("0930-1600", "Trading session", group = groupTest)
useSessionFilter = input.bool(true, "Restrict intraday entries to session", group = groupTest)
closeAtSessionEnd = input.bool(true, "Flatten near session close", group = groupTest)

groupCatalyst = "02 — CatalystAI research gate"
catalystScore = input.float(70.0, "CatalystAI score", minval = 0, maxval = 100, group = groupCatalyst)
catalystConfidence = input.float(75.0, "Research confidence (%)", minval = 0, maxval = 100, group = groupCatalyst)
minimumCatalystScore = input.float(60.0, "Minimum score", minval = 0, maxval = 100, group = groupCatalyst)
minimumConfidence = input.float(60.0, "Minimum confidence (%)", minval = 0, maxval = 100, group = groupCatalyst)

groupVwap = "03 — VWAP structure"
vwapMode = input.string("Weekly", "Anchor mode", options = ["Session", "Weekly", "Monthly", "Anchored"], group = groupVwap)
anchorTime = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Manual anchor", group = groupVwap)
bandMultiplier = input.float(1.0, "Band deviation", minval = 0.1, step = 0.1, group = groupVwap)
maximumExtension = input.float(2.5, "Maximum VWAP extension (ATR)", minval = 0.25, step = 0.25, group = groupVwap)

groupTrend = "04 — Trend and timeframe confirmation"
fastLength = input.int(20, "Fast EMA", minval = 2, group = groupTrend)
slowLength = input.int(50, "Slow EMA", minval = 5, group = groupTrend)
longLength = input.int(200, "Long EMA", minval = 20, group = groupTrend)
diLength = input.int(14, "DI length", minval = 2, group = groupTrend)
adxSmoothing = input.int(14, "ADX smoothing", minval = 2, group = groupTrend)
minimumAdx = input.float(18.0, "Minimum ADX", minval = 0, group = groupTrend)
minimumMtfVotes = input.int(2, "Required MTF votes", minval = 0, maxval = 3, group = groupTrend)
higherTimeframe1 = input.timeframe("60", "Confirmation timeframe 1", group = groupTrend)
higherTimeframe2 = input.timeframe("240", "Confirmation timeframe 2", group = groupTrend)
higherTimeframe3 = input.timeframe("D", "Confirmation timeframe 3", group = groupTrend)

groupEvidence = "05 — Market evidence"
marketSymbol = input.symbol("AMEX:SPY", "Market benchmark", group = groupEvidence)
sectorSymbol = input.symbol("AMEX:XLK", "Sector benchmark", group = groupEvidence)
relativeStrengthLength = input.int(63, "Relative-strength bars", minval = 5, group = groupEvidence)
volumeLength = input.int(20, "Volume baseline", minval = 5, group = groupEvidence)
minimumVolumeRatio = input.float(0.8, "Minimum relative volume", minval = 0, step = 0.1, group = groupEvidence)
swingLength = input.int(5, "Confirmed swing strength", minval = 2, group = groupEvidence)
minimumEvidence = input.float(0.62, "Minimum evidence score", minval = 0, maxval = 1, step = 0.01, group = groupEvidence)
cooldownBars = input.int(5, "Signal cooldown bars", minval = 0, group = groupEvidence)

groupRisk = "06 — Risk and exits"
atrLength = input.int(14, "ATR length", minval = 2, group = groupRisk)
stopAtrMultiplier = input.float(1.5, "Initial stop (ATR)", minval = 0.25, step = 0.25, group = groupRisk)
structureBuffer = input.float(0.25, "Structure buffer (ATR)", minval = 0, step = 0.05, group = groupRisk)
firstTargetR = input.float(1.0, "First target (R)", minval = 0.25, step = 0.25, group = groupRisk)
finalTargetR = input.float(2.5, "Runner target (R)", minval = 0.5, step = 0.25, group = groupRisk)
firstTargetQuantity = input.float(50, "First target quantity (%)", minval = 1, maxval = 99, group = groupRisk)
riskBudget = input.float(1.0, "Equity risk per trade (%)", minval = 0.1, maxval = 5, step = 0.1, group = groupRisk)
maximumAllocation = input.float(20.0, "Maximum allocation (%)", minval = 1, maxval = 100, group = groupRisk)
breakEvenAfterFirstTarget = input.bool(true, "Move runner to break-even after T1", group = groupRisk)
trailAtrMultiplier = input.float(2.0, "Runner trail (ATR)", minval = 0.25, step = 0.25, group = groupRisk)
maximumBarsInTrade = input.int(80, "Maximum bars in trade", minval = 1, group = groupRisk)
exitOnVwapFailure = input.bool(true, "Exit on confirmed VWAP failure", group = groupRisk)

bool calendarReset = switch vwapMode
    "Session" => timeframe.change("1D")
    "Weekly" => timeframe.change("1W")
    "Monthly" => timeframe.change("1M")
    => false
bool anchoredActive = vwapMode != "Anchored" or time >= anchorTime
bool firstAnchorBar = vwapMode == "Anchored" and time >= anchorTime and nz(time[1], 0) < anchorTime
bool resetVwap = calendarReset or firstAnchorBar

var float cumulativePV = na
var float cumulativeV = na
var float cumulativePV2 = na
if not anchoredActive
    cumulativePV := na
    cumulativeV := na
    cumulativePV2 := na
else if resetVwap or na(cumulativePV)
    cumulativePV := hlc3 * volume
    cumulativeV := volume
    cumulativePV2 := hlc3 * hlc3 * volume
else
    cumulativePV += hlc3 * volume
    cumulativeV += volume
    cumulativePV2 += hlc3 * hlc3 * volume

float activeVwap = cumulativeV > 0 ? cumulativePV / cumulativeV : na
float weightedVariance = cumulativeV > 0 ? math.max(cumulativePV2 / cumulativeV - activeVwap * activeVwap, 0) : na
float weightedDeviation = math.sqrt(weightedVariance)
float upperBand = activeVwap + bandMultiplier * weightedDeviation
float lowerBand = activeVwap - bandMultiplier * weightedDeviation

float fastEma = ta.ema(close, fastLength)
float slowEma = ta.ema(close, slowLength)
float longEma = ta.ema(close, longLength)
[plusDi, minusDi, adx] = ta.dmi(diLength, adxSmoothing)
float atr = ta.atr(atrLength)

f_mtfVote(string requestedTimeframe) =>
    float confirmedClose = request.security(syminfo.tickerid, requestedTimeframe, close[1], barmerge.gaps_off, barmerge.lookahead_off)
    float confirmedFast = request.security(syminfo.tickerid, requestedTimeframe, ta.ema(close, fastLength)[1], barmerge.gaps_off, barmerge.lookahead_off)
    float confirmedSlow = request.security(syminfo.tickerid, requestedTimeframe, ta.ema(close, slowLength)[1], barmerge.gaps_off, barmerge.lookahead_off)
    confirmedClose > confirmedFast and confirmedFast > confirmedSlow ? 1 : confirmedClose < confirmedFast and confirmedFast < confirmedSlow ? -1 : 0

int vote1 = f_mtfVote(higherTimeframe1)
int vote2 = f_mtfVote(higherTimeframe2)
int vote3 = f_mtfVote(higherTimeframe3)
int bullishVotes = (vote1 == 1 ? 1 : 0) + (vote2 == 1 ? 1 : 0) + (vote3 == 1 ? 1 : 0)
int bearishVotes = (vote1 == -1 ? 1 : 0) + (vote2 == -1 ? 1 : 0) + (vote3 == -1 ? 1 : 0)

float marketClose = request.security(marketSymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
float sectorClose = request.security(sectorSymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
float stockReturn = close / close[relativeStrengthLength] - 1
float marketReturn = marketClose / marketClose[relativeStrengthLength] - 1
float sectorReturn = sectorClose / sectorClose[relativeStrengthLength] - 1
bool marketLeadership = stockReturn > marketReturn
bool sectorLeadership = stockReturn > sectorReturn
bool marketWeakness = stockReturn < marketReturn
bool sectorWeakness = stockReturn < sectorReturn

float volumeBaseline = ta.sma(volume, volumeLength)
float volumeRatio = volumeBaseline > 0 ? volume / volumeBaseline : 0
float signedVolume = close > open ? volume : close < open ? -volume : 0
float accumulationPressure = ta.ema(signedVolume, volumeLength) / math.max(ta.ema(volume, volumeLength), 1)
bool accumulating = accumulationPressure > 0.05 and volumeRatio >= minimumVolumeRatio
bool distributing = accumulationPressure < -0.05 and volumeRatio >= minimumVolumeRatio

float confirmedSwingHigh = ta.pivothigh(high, swingLength, swingLength)
float confirmedSwingLow = ta.pivotlow(low, swingLength, swingLength)
float lastSwingHigh = ta.valuewhen(not na(confirmedSwingHigh), confirmedSwingHigh, 0)
float lastSwingLow = ta.valuewhen(not na(confirmedSwingLow), confirmedSwingLow, 0)
bool bullishBreak = not na(lastSwingHigh) and close > lastSwingHigh
bool bearishBreak = not na(lastSwingLow) and close < lastSwingLow
bool bullishReclaim = ta.crossover(close, activeVwap) or low <= lowerBand and close > activeVwap
bool bearishReclaim = ta.crossunder(close, activeVwap) or high >= upperBand and close < activeVwap

float longContext = (marketLeadership ? 0.5 : 0.0) + (sectorLeadership ? 0.5 : 0.0)
float shortContext = (marketWeakness ? 0.5 : 0.0) + (sectorWeakness ? 0.5 : 0.0)
float longTrend = (fastEma > slowEma ? 0.35 : 0.0) + (slowEma > longEma ? 0.35 : 0.0) + (plusDi > minusDi and adx >= minimumAdx ? 0.3 : 0.0)
float shortTrend = (fastEma < slowEma ? 0.35 : 0.0) + (slowEma < longEma ? 0.35 : 0.0) + (minusDi > plusDi and adx >= minimumAdx ? 0.3 : 0.0)
float longStructure = (bullishReclaim ? 0.5 : 0.0) + (bullishBreak ? 0.5 : 0.0)
float shortStructure = (bearishReclaim ? 0.5 : 0.0) + (bearishBreak ? 0.5 : 0.0)
float longEvidence = 0.25 * longContext + 0.30 * longTrend + 0.20 * (accumulating ? 1.0 : 0.0) + 0.25 * longStructure
float shortEvidence = 0.25 * shortContext + 0.30 * shortTrend + 0.20 * (distributing ? 1.0 : 0.0) + 0.25 * shortStructure

bool inDateRange = time >= startDate and time <= endDate
bool inSession = not timeframe.isintraday or not useSessionFilter or not na(time(timeframe.period, tradeSession))
bool researchApproved = catalystScore >= minimumCatalystScore and catalystConfidence >= minimumConfidence
bool longLocation = close >= activeVwap and (close - activeVwap) / atr <= maximumExtension
bool shortLocation = close <= activeVwap and (activeVwap - close) / atr <= maximumExtension
var int lastSignalBar = na
bool cooldownReady = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
bool longSignal = barstate.isconfirmed and inDateRange and inSession and cooldownReady and allowLongs and researchApproved and longLocation and bullishVotes >= minimumMtfVotes and longEvidence >= minimumEvidence
bool shortSignal = barstate.isconfirmed and inDateRange and inSession and cooldownReady and allowShorts and researchApproved and shortLocation and bearishVotes >= minimumMtfVotes and shortEvidence >= minimumEvidence

float longAtrStop = close - stopAtrMultiplier * atr
float longStructureStop = na(lastSwingLow) ? longAtrStop : lastSwingLow - structureBuffer * atr
float longCandidateStop = math.max(longAtrStop, longStructureStop)
float shortAtrStop = close + stopAtrMultiplier * atr
float shortStructureStop = na(lastSwingHigh) ? shortAtrStop : lastSwingHigh + structureBuffer * atr
float shortCandidateStop = math.min(shortAtrStop, shortStructureStop)
float longRisk = math.max(close - longCandidateStop, syminfo.mintick)
float shortRisk = math.max(shortCandidateStop - close, syminfo.mintick)
float riskCapital = strategy.equity * riskBudget / 100
float allocationQuantity = strategy.equity * maximumAllocation / 100 / close
float longQuantity = math.max(math.min(riskCapital / math.max(longRisk * syminfo.pointvalue, syminfo.mintick), allocationQuantity), 0)
float shortQuantity = math.max(math.min(riskCapital / math.max(shortRisk * syminfo.pointvalue, syminfo.mintick), allocationQuantity), 0)

var float initialStop = na
var float initialRisk = na
var float firstTarget = na
var float finalTarget = na
var float runnerStop = na
var int entryBar = na
var bool firstTargetTouched = false

if strategy.position_size == 0
    if longSignal and longQuantity > 0
        initialStop := longCandidateStop
        initialRisk := longRisk
        firstTarget := close + firstTargetR * longRisk
        finalTarget := close + finalTargetR * longRisk
        runnerStop := initialStop
        entryBar := bar_index
        firstTargetTouched := false
        lastSignalBar := bar_index
        strategy.entry("Long", strategy.long, qty = longQuantity)
    else if shortSignal and shortQuantity > 0
        initialStop := shortCandidateStop
        initialRisk := shortRisk
        firstTarget := close - firstTargetR * shortRisk
        finalTarget := close - finalTargetR * shortRisk
        runnerStop := initialStop
        entryBar := bar_index
        firstTargetTouched := false
        lastSignalBar := bar_index
        strategy.entry("Short", strategy.short, qty = shortQuantity)

if strategy.position_size > 0
    firstTargetTouched := firstTargetTouched or high >= firstTarget
    float longTrail = close - trailAtrMultiplier * atr
    runnerStop := firstTargetTouched and breakEvenAfterFirstTarget ? math.max(math.max(runnerStop, strategy.position_avg_price), longTrail) : math.max(runnerStop, longTrail)
    strategy.exit("Long T1", "Long", stop = initialStop, limit = firstTarget, qty_percent = firstTargetQuantity)
    strategy.exit("Long runner", "Long", stop = runnerStop, limit = finalTarget, qty_percent = 100 - firstTargetQuantity)
    if exitOnVwapFailure and barstate.isconfirmed and close < activeVwap
        strategy.close("Long", comment = "VWAP failure")

if strategy.position_size < 0
    firstTargetTouched := firstTargetTouched or low <= firstTarget
    float shortTrail = close + trailAtrMultiplier * atr
    runnerStop := firstTargetTouched and breakEvenAfterFirstTarget ? math.min(math.min(runnerStop, strategy.position_avg_price), shortTrail) : math.min(runnerStop, shortTrail)
    strategy.exit("Short T1", "Short", stop = initialStop, limit = firstTarget, qty_percent = firstTargetQuantity)
    strategy.exit("Short runner", "Short", stop = runnerStop, limit = finalTarget, qty_percent = 100 - firstTargetQuantity)
    if exitOnVwapFailure and barstate.isconfirmed and close > activeVwap
        strategy.close("Short", comment = "VWAP failure")

bool timeStop = strategy.position_size != 0 and not na(entryBar) and bar_index - entryBar >= maximumBarsInTrade
bool afterSession = timeframe.isintraday and closeAtSessionEnd and na(time(timeframe.period, tradeSession)) and not na(time(timeframe.period, tradeSession)[1])
if timeStop or afterSession or time > endDate
    strategy.close_all(comment = timeStop ? "Time stop" : afterSession ? "Session close" : "Backtest end")

if strategy.position_size == 0 and strategy.position_size[1] != 0
    initialStop := na
    initialRisk := na
    firstTarget := na
    finalTarget := na
    runnerStop := na
    entryBar := na
    firstTargetTouched := false

plot(activeVwap, "Active VWAP", color = close >= activeVwap ? color.teal : color.orange, linewidth = 2)
upperPlot = plot(upperBand, "Upper VWAP band", color = color.new(color.teal, 55))
lowerPlot = plot(lowerBand, "Lower VWAP band", color = color.new(color.teal, 55))
fill(upperPlot, lowerPlot, color = color.new(color.teal, 92), title = "VWAP value area")
plot(fastEma, "Fast EMA", color = color.new(color.blue, 25))
plot(slowEma, "Slow EMA", color = color.new(color.purple, 25))
plot(strategy.position_size != 0 ? runnerStop : na, "Active runner stop", color = color.red, style = plot.style_linebr)
plot(strategy.position_size != 0 ? firstTarget : na, "First target", color = color.new(color.lime, 25), style = plot.style_linebr)
plot(strategy.position_size != 0 ? finalTarget : na, "Final target", color = color.lime, style = plot.style_linebr)
plotshape(longSignal and strategy.position_size == 0, "Long setup", shape.triangleup, location.belowbar, color.lime, size = size.tiny)
plotshape(shortSignal and strategy.position_size == 0, "Short setup", shape.triangledown, location.abovebar, color.red, size = size.tiny)

var table dashboard = table.new(position.top_right, 2, 6, border_width = 1)
if barstate.islast
    table.cell(dashboard, 0, 0, "CatalystAI", bgcolor = color.new(color.blue, 70))
    table.cell(dashboard, 1, 0, researchApproved ? "APPROVED" : "BLOCKED", text_color = researchApproved ? color.lime : color.red)
    table.cell(dashboard, 0, 1, "Score / confidence")
    table.cell(dashboard, 1, 1, str.tostring(catalystScore, "#.0") + " / " + str.tostring(catalystConfidence, "#.0") + "%")
    table.cell(dashboard, 0, 2, "Long evidence")
    table.cell(dashboard, 1, 2, str.tostring(longEvidence * 100, "#.0") + "%")
    table.cell(dashboard, 0, 3, "Short evidence")
    table.cell(dashboard, 1, 3, str.tostring(shortEvidence * 100, "#.0") + "%")
    table.cell(dashboard, 0, 4, "MTF votes L / S")
    table.cell(dashboard, 1, 4, str.tostring(bullishVotes) + " / " + str.tostring(bearishVotes))
    table.cell(dashboard, 0, 5, "VWAP mode")
    table.cell(dashboard, 1, 5, vwapMode)

alertcondition(longSignal and strategy.position_size == 0, "CatalystAI VWAPPlus long", "CatalystAI VWAPPlus PRO long conditions passed on {{ticker}}.")
alertcondition(shortSignal and strategy.position_size == 0, "CatalystAI VWAPPlus short", "CatalystAI VWAPPlus PRO short conditions passed on {{ticker}}.")
