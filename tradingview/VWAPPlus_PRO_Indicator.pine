//@version=6
indicator("CatalystAI VWAPPlus PRO", "VWAPPlus PRO", overlay = true, max_labels_count = 200)

// This indicator is an execution aid, not an investment recommendation.
groupVwap = "VWAP structure"
vwapMode = input.string("Weekly", "Anchor mode", options = ["Session", "Weekly", "Monthly", "Anchored"], group = groupVwap)
anchorTime = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Manual anchor", group = groupVwap)
bandMultiplier = input.float(1.0, "Band deviation", minval = 0.1, step = 0.1, group = groupVwap)

groupEvidence = "Market evidence"
marketSymbol = input.symbol("AMEX:SPY", "Market benchmark", group = groupEvidence)
sectorSymbol = input.symbol("AMEX:XLK", "Sector benchmark", group = groupEvidence)
relativeStrengthLength = input.int(63, "Relative-strength bars", minval = 5, group = groupEvidence)
volumeLength = input.int(20, "Volume baseline", minval = 5, group = groupEvidence)
sweepLookback = input.int(20, "Liquidity-sweep lookback", minval = 5, group = groupEvidence)
crashLookback = input.int(63, "Crash lookback", minval = 20, group = groupEvidence)
crashThreshold = input.float(20.0, "Crash threshold (%)", minval = 5, step = 1, group = groupEvidence)

groupCatalyst = "CatalystAI research gate"
catalystScore = input.float(70.0, "CatalystAI score", minval = 0, maxval = 100, group = groupCatalyst)
catalystConfidence = input.float(75.0, "Research confidence (%)", minval = 0, maxval = 100, group = groupCatalyst)
minimumCatalystScore = input.float(60.0, "Minimum score", minval = 0, maxval = 100, group = groupCatalyst)
minimumConfidence = input.float(60.0, "Minimum confidence (%)", minval = 0, maxval = 100, group = groupCatalyst)

groupRisk = "Risk framework"
atrLength = input.int(14, "ATR length", minval = 2, group = groupRisk)
stopAtrMultiplier = input.float(1.5, "Stop distance (ATR)", minval = 0.25, step = 0.25, group = groupRisk)
targetRiskMultiple = input.float(2.0, "Target R multiple", minval = 0.5, step = 0.25, group = groupRisk)
riskBudget = input.float(1.0, "Risk budget (%)", minval = 0.1, maxval = 5, step = 0.1, group = groupRisk)

bool calendarReset = switch vwapMode
    "Session" => timeframe.change("1D")
    "Weekly" => timeframe.change("1W")
    "Monthly" => timeframe.change("1M")
    => false
bool anchoredActive = vwapMode != "Anchored" or time >= anchorTime
bool firstAnchorBar = vwapMode == "Anchored" and time >= anchorTime and nz(time[1], 0) < anchorTime
bool resetVwap = calendarReset or firstAnchorBar

var float cumulativePV = na
var float cumulativeV = na
var float cumulativePV2 = na
if not anchoredActive
    cumulativePV := na
    cumulativeV := na
    cumulativePV2 := na
else if resetVwap or na(cumulativePV)
    cumulativePV := hlc3 * volume
    cumulativeV := volume
    cumulativePV2 := hlc3 * hlc3 * volume
else
    cumulativePV += hlc3 * volume
    cumulativeV += volume
    cumulativePV2 += hlc3 * hlc3 * volume

float activeVwap = cumulativeV > 0 ? cumulativePV / cumulativeV : na
float weightedVariance = cumulativeV > 0 ? math.max(cumulativePV2 / cumulativeV - activeVwap * activeVwap, 0) : na
float weightedDeviation = math.sqrt(weightedVariance)
float upperBand = activeVwap + bandMultiplier * weightedDeviation
float lowerBand = activeVwap - bandMultiplier * weightedDeviation

float marketClose = request.security(marketSymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
float sectorClose = request.security(sectorSymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
float stockReturn = close / close[relativeStrengthLength] - 1
float marketReturn = marketClose / marketClose[relativeStrengthLength] - 1
float sectorReturn = sectorClose / sectorClose[relativeStrengthLength] - 1
bool marketLeadership = stockReturn > marketReturn
bool sectorLeadership = stockReturn > sectorReturn

float volumeBaseline = ta.sma(volume, volumeLength)
float volumeRatio = volumeBaseline > 0 ? volume / volumeBaseline : 0
float signedVolume = close > open ? volume : close < open ? -volume : 0
float accumulationPressure = ta.ema(signedVolume, volumeLength) / math.max(ta.ema(volume, volumeLength), 1)
bool accumulating = accumulationPressure > 0.05 and volumeRatio > 0.8
bool distributing = accumulationPressure < -0.05 and volumeRatio > 0.8

float priorLow = ta.lowest(low[1], sweepLookback)
bool liquiditySweep = low < priorLow and close > priorLow and close > open
float rollingHigh = ta.highest(high, crashLookback)
float drawdownPercent = rollingHigh > 0 ? 100 * (close / rollingHigh - 1) : 0
bool crashReclaim = drawdownPercent <= -crashThreshold and ta.crossover(close, activeVwap)

float trendAverage = ta.ema(close, 50)
bool bullishRegime = close > activeVwap and close > trendAverage
bool researchApproved = catalystScore >= minimumCatalystScore and catalystConfidence >= minimumConfidence
bool evidenceApproved = marketLeadership and sectorLeadership and accumulating
bool longSetup = barstate.isconfirmed and researchApproved and bullishRegime and evidenceApproved
bool enhancedSetup = longSetup and (liquiditySweep or crashReclaim)

float atr = ta.atr(atrLength)
float invalidation = activeVwap - stopAtrMultiplier * atr
float riskPerShare = math.max(close - invalidation, syminfo.mintick)
float target = close + targetRiskMultiple * riskPerShare
float suggestedPositionPercent = math.min(100, riskBudget / (riskPerShare / close))

color vwapColor = bullishRegime ? color.teal : color.orange
plot(activeVwap, "Active VWAP", color = vwapColor, linewidth = 2)
upperPlot = plot(upperBand, "Upper VWAP band", color = color.new(color.teal, 55))
lowerPlot = plot(lowerBand, "Lower VWAP band", color = color.new(color.teal, 55))
fill(upperPlot, lowerPlot, color = color.new(color.teal, 92), title = "VWAP value area")
plot(longSetup ? invalidation : na, "Invalidation", color = color.red, style = plot.style_linebr)
plot(longSetup ? target : na, "Target", color = color.lime, style = plot.style_linebr)

plotshape(longSetup and not enhancedSetup, "VWAPPlus setup", shape.triangleup, location.belowbar, color.teal, size = size.tiny, text = "VP")
plotshape(enhancedSetup, "Enhanced setup", shape.triangleup, location.belowbar, color.lime, size = size.small, text = "VP+")
plotshape(liquiditySweep, "Liquidity sweep", shape.circle, location.belowbar, color.aqua, size = size.tiny)
plotshape(distributing, "Distribution", shape.circle, location.abovebar, color.red, size = size.tiny)

bgcolor(not researchApproved ? color.new(color.gray, 94) : na, title = "Research gate inactive")

if barstate.islast
    var table status = table.new(position.top_right, 2, 8, border_width = 1)
    table.cell(status, 0, 0, "CatalystAI")
    table.cell(status, 1, 0, str.tostring(catalystScore, "#.0") + " / " + str.tostring(catalystConfidence, "#.0") + "%")
    table.cell(status, 0, 1, "Research gate")
    table.cell(status, 1, 1, researchApproved ? "PASS" : "BLOCK", text_color = researchApproved ? color.lime : color.red)
    table.cell(status, 0, 2, "Market RS")
    table.cell(status, 1, 2, marketLeadership ? "PASS" : "FAIL")
    table.cell(status, 0, 3, "Sector RS")
    table.cell(status, 1, 3, sectorLeadership ? "PASS" : "FAIL")
    table.cell(status, 0, 4, "Flow")
    table.cell(status, 1, 4, accumulating ? "ACCUM" : distributing ? "DIST" : "NEUTRAL")
    table.cell(status, 0, 5, "Regime")
    table.cell(status, 1, 5, bullishRegime ? "BULL" : "DEFENSIVE")
    table.cell(status, 0, 6, "Risk size")
    table.cell(status, 1, 6, str.tostring(suggestedPositionPercent, "#.1") + "%")
    table.cell(status, 0, 7, "Anchor")
    table.cell(status, 1, 7, vwapMode)

alertcondition(longSetup, "VWAPPlus PRO setup", "CatalystAI research gate and VWAPPlus execution evidence passed on {{ticker}}.")
alertcondition(enhancedSetup, "VWAPPlus PRO enhanced setup", "VWAPPlus enhanced liquidity/reclaim setup passed on {{ticker}}.")
alertcondition(liquiditySweep, "Liquidity sweep", "Bullish liquidity sweep detected on {{ticker}}.")
alertcondition(distributing, "Distribution warning", "Distribution pressure detected on {{ticker}}.")

